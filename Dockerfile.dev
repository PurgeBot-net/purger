FROM golang:1.26-alpine AS builder
WORKDIR /build

COPY common/   ./common/
COPY database/ ./database/
COPY locale/   ./locale/
COPY purger/   ./purger/

WORKDIR /build/purger
RUN go work init . ../common ../database ../locale
RUN go build -o /purger ./cmd/

FROM alpine:latest
RUN adduser -D -g '' container
USER container
COPY --from=builder /purger /purger
ENTRYPOINT ["/purger"]
